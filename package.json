{
  "name": "@nuxtjs/better-auth",
  "type": "module",
  "version": "0.3.14",
  "packageManager": "pnpm@12.15.0",
  "description": "Nuxt module for Better Auth integration with NuxtHub, route protection, session management, and role-based access",
  "author": "onmax",
  "license": "MIT",
  "homepage": "https://better-auth.nuxt.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuxt-modules/better-auth"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./composables": {
      "types": "./dist/runtime/composables.d.ts",
      "import": "./dist/runtime/composables.js"
    },
    "./config": {
      "types": "./dist/runtime/config.d.ts",
      "import": "./dist/runtime/config.js"
    },
    "./test-utils/runtime": {
      "types": "./dist/runtime/test-utils/runtime.d.ts",
      "import": "./dist/runtime/test-utils/runtime.js"
    },
    "./test-utils/e2e": {
      "types": "./dist/runtime/test-utils/e2e.d.ts",
      "import": "./dist/runtime/test-utils/e2e.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "composables": [
        "./dist/runtime/composables.d.ts"
      ],
      "config": [
        "./dist/runtime/config.d.ts"
      ],
      "test-utils/runtime": [
        "./dist/runtime/test-utils/runtime.d.ts"
      ],
      "test-utils/e2e": [
        "./dist/runtime/test-utils/e2e.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepack": "NODE_OPTIONS='--import=./scripts/typescript6-shim.mjs --experimental-loader=./scripts/typescript6-shim.mjs' nuxt-module-build build",
    "build": "pnpm build:docs",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "dev:docs": "nuxi dev docs",
    "build:docs": "nuxi build docs",
    "deploy": "wrangler deploy",
    "lint": "NODE_OPTIONS='--import=./scripts/typescript6-shim.mjs --experimental-loader=./scripts/typescript6-shim.mjs' eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "NODE_OPTIONS='--import=./scripts/typescript6-shim.mjs --experimental-loader=./scripts/typescript6-shim.mjs' vue-tsc --noEmit",
    "typecheck:runtime-server": "cd test/cases/plugins-type-inference && NODE_OPTIONS='--import=../../../scripts/typescript6-shim.mjs --experimental-loader=../../../scripts/typescript6-shim.mjs' nuxi prepare && NODE_OPTIONS='--import=../../../scripts/typescript6-shim.mjs --experimental-loader=../../../scripts/typescript6-shim.mjs' vue-tsc --noEmit --pretty false -p .nuxt/tsconfig.server.json",
    "typecheck:playground": "NODE_OPTIONS=\"--import=$PWD/scripts/typescript6-shim.mjs --experimental-loader=$PWD/scripts/typescript6-shim.mjs\" pnpm -C playground exec nuxi prepare && NODE_OPTIONS=\"--import=$PWD/scripts/typescript6-shim.mjs --experimental-loader=$PWD/scripts/typescript6-shim.mjs\" pnpm -C playground exec vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:runtime": "vitest run --config vitest.runtime.config.ts"
  },
  "peerDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@nuxthub/core": ">=0.10.5",
    "auth": "1.7.14",
    "better-auth": ">=1.7.3 <2"
  },
  "peerDependenciesMeta": {
    "@nuxt/test-utils": {
      "optional": true
    },
    "@nuxthub/core": {
      "optional": true
    },
    "auth": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^4.0.0",
    "@nuxt/kit": "^4.6.2",
    "@types/node": "^24.19.2",
    "consola": "^3.4.2",
    "cookie-es": "^3.1.1",
    "defu": "^6.1.7",
    "get-port-please": "^3.2.0",
    "h3": "^2.0.8",
    "jiti": "^2.7.0",
    "nostics": "^1.3.0",
    "pathe": "^2.0.3",
    "radix3": "^1.1.2",
    "std-env": "^4.3.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxthub/core": "^0.10.11",
    "@pinia/nuxt": "^1.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@typescript/typescript6": "6.0.2",
    "@vue/test-utils": "^2.5.1",
    "auth": "1.7.14",
    "better-auth": "1.7.14",
    "better-call": "1.4.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "nitropack": "2.13.5",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "pkg-pr-new": "0.0.92",
    "playwright-core": "1.64.1",
    "postgres": "^3.4.9",
    "typescript": "~7.0.0",
    "typescript-next": "npm:typescript@~7.0.0",
    "unstorage": "^1.17.5",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.153.0",
    "yaml": "^2.9.1"
  }
}
